[Unit]
Description=Raise-game secondary HTTP liveness watchdog
After=raising-game-demo-b.service
ConditionPathExists=/opt/raising-game-demo/ops/secondary-watchdog.sh

[Service]
Type=oneshot
User=root
Environment=HEALTH_URL=http://127.0.0.1:4175/api/livez
Environment=READINESS_URL=http://127.0.0.1:4175/api/readyz
Environment=READINESS_REQUIRED=1
Environment=DEPENDENCY_FAILURE_THRESHOLD=3
Environment=DEPENDENCY_STATE_FILE=/run/raising-game-watchdog-b.dependency.failures
Environment=FAILURE_THRESHOLD=3
Environment=TIMEOUT_SECONDS=3
Environment=SERVICE=raising-game-demo-b.service
Environment=SERVICE_CHECK_ACTIVE=1
Environment=STATE_FILE=/run/raising-game-watchdog-b.failures
Environment=LOCK_FILE=/run/raising-game-watchdog-b.lock
Environment=WARMUP_SECONDS=45
Environment=RESTART_COOLDOWN_SECONDS=60
Environment=RESTART_BACKOFF_MAX_SECONDS=900
Environment=RESTART_MAX_PER_HOUR=3
Environment=RESTART_STATE_FILE=/run/raising-game-watchdog-b.restarts
Environment=RESTART_PENDING_FILE=/run/raising-game-watchdog-b.restart.pending
ExecStart=/opt/raising-game-demo/ops/secondary-watchdog.sh
Nice=10
