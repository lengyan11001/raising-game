# Copy to .env.local and fill real values. .env.local is intentionally ignored.
BYTEPLUS_USERNAME=
BYTEPLUS_ACCOUNT_ID=
BYTEPLUS_LOGIN_URL=

ARK_API_KEY=
BYTEPLUS_ACCESS_KEY_ID=
BYTEPLUS_SECRET_ACCESS_KEY=

SEEDANCE_FAST_ENDPOINT_ID=
SEEDANCE_ENDPOINT_ID=
TOOL_VIDEO_PROVIDER=wan27

APIZ_API_KEY=
APIZ_SDK_REPO=https://github.com/xuliang2024/apiz-sdk

# Dedicated APIZ credentials for Seedance 2.5 Advanced generation.
SEEDANCE25_API_BASE_URL=https://api.apiz.ai
SEEDANCE25_API_KEY=
SEEDANCE25_MODEL_ID=st-ai/super-seed2-lite
SEEDANCE25_INNER_MODEL=Seedance_2.5

# Ignex is the second Seedance upstream. Keep empty unless a user is explicitly routed there for testing.
IGNEX_API_BASE_URL=https://api.ignex.ai
IGNEX_API_KEY=
IGNEX_ENABLED_USERS=
IGNEX_PROJECT_NAME=default
IGNEX_ASSET_GROUP_ID=
IGNEX_ASSET_GROUP_NAME=vipeak-seedance
USDT_CNY_CENTS=720
MIN_TOPUP_AMOUNT=1

# PayPal Checkout. Create these in PayPal Developer; never commit real values.
PAYPAL_ENV=live
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_CURRENCY=USD
PAYPAL_BRAND_NAME=Vipeak AI
PAYPAL_MIN_AMOUNT=1
# Credits conversion for PayPal top-up amount. Default falls back to USDT_CNY_CENTS.
PAYPAL_CNY_CENTS_PER_UNIT=720

NODE_ENV=production
PORT=4174

# Cloudflare R2 is the only production object storage provider.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto
R2_BUCKET=
R2_PUBLIC_BASE_URL=
R2_KEY_PREFIX=
SITE_STORAGE_SLUG=
DISABLE_R2_STORAGE=false

PGPOOL_MAX=20
PGPOOL_IDLE_TIMEOUT_MS=30000
PGPOOL_CONNECTION_TIMEOUT_MS=5000
PGPOOL_MAX_USES=7500
HTTP_KEEP_ALIVE_TIMEOUT_MS=65000
HTTP_HEADERS_TIMEOUT_MS=70000
HTTP_REQUEST_TIMEOUT_MS=180000
HTTP_MAX_REQUESTS_PER_SOCKET=1000
HTTP_MAX_CONNECTIONS=2000
BLOCK_MAINLAND_CHINA=0
MAINLAND_BYPASS_TOKEN=
MAINLAND_BYPASS_QUERY_PARAM=cnpass
MAINLAND_BYPASS_COOKIE=cnpass
MAINLAND_BYPASS_MAX_AGE_SECONDS=86400

# Alibaba Cloud Model Studio / Bailian Singapore DashScope endpoint for Advanced Wan2.7.
