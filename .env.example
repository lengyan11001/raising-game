# Copy to .env.local and fill real values. .env.local is intentionally ignored.
BYTEPLUS_USERNAME=
BYTEPLUS_ACCOUNT_ID=
BYTEPLUS_LOGIN_URL=

ARK_API_KEY=
BYTEPLUS_ACCESS_KEY_ID=
BYTEPLUS_SECRET_ACCESS_KEY=

SEEDANCE_FAST_ENDPOINT_ID=
SEEDANCE_ENDPOINT_ID=
TOOL_VIDEO_PROVIDER=wan27

APIZ_API_KEY=
APIZ_SDK_REPO=https://github.com/xuliang2024/apiz-sdk

# Dedicated APIZ credentials for Seedance 2.5 Advanced generation.
SEEDANCE25_API_BASE_URL=https://api.apiz.ai
SEEDANCE25_API_KEY=
SEEDANCE25_MODEL_ID=st-ai/super-seed2-lite
SEEDANCE25_INNER_MODEL=Seedance_2.5

# Ignex is the second Seedance upstream. Keep empty unless a user is explicitly routed there for testing.
IGNEX_API_BASE_URL=https://api.ignex.ai
IGNEX_API_KEY=
IGNEX_ENABLED_USERS=
IGNEX_PROJECT_NAME=default
IGNEX_ASSET_GROUP_ID=
IGNEX_ASSET_GROUP_NAME=vipeak-seedance
USDT_CNY_CENTS=720
MIN_TOPUP_AMOUNT=1

# PayPal Checkout. Create these in PayPal Developer; never commit real values.
PAYPAL_ENV=live
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_CURRENCY=USD
PAYPAL_BRAND_NAME=Vipeak AI
PAYPAL_MIN_AMOUNT=1
# Credits conversion for PayPal top-up amount. Default falls back to USDT_CNY_CENTS.
PAYPAL_CNY_CENTS_PER_UNIT=720

NODE_ENV=production
PORT=4174

# Cloudflare R2 is the only production object storage provider.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto
R2_BUCKET=
R2_PUBLIC_BASE_URL=
R2_KEY_PREFIX=
SITE_STORAGE_SLUG=
DISABLE_R2_STORAGE=false
# R2 uploads use this as the minimum timeout and grow it with file size at the expected minimum throughput.
R2_UPLOAD_TIMEOUT_MS=120000
R2_UPLOAD_MAX_TIMEOUT_MS=900000
R2_UPLOAD_MIN_BYTES_PER_SECOND=262144

PGPOOL_MAX=20
PGPOOL_IDLE_TIMEOUT_MS=30000
PGPOOL_CONNECTION_TIMEOUT_MS=5000
PGPOOL_MAX_USES=7500
HTTP_KEEP_ALIVE_TIMEOUT_MS=65000
HTTP_HEADERS_TIMEOUT_MS=70000
HTTP_REQUEST_TIMEOUT_MS=180000
HTTP_MAX_REQUESTS_PER_SOCKET=1000
HTTP_MAX_CONNECTIONS=2000
BLOCK_MAINLAND_CHINA=1
# Set to 1 to expose every Alibaba model family. Prefer the family-specific switches below.
PUBLIC_ALIYUN_MODEL_EXPOSURE_ENABLED=0
# Selectively expose Wan3.0 while keeping legacy Alibaba models hidden.
PUBLIC_WAN30_MODEL_EXPOSURE_ENABLED=0
# Selectively expose Wan2.7, Wan Animate, and Wan2.7 image editing.
PUBLIC_WAN27_MODEL_EXPOSURE_ENABLED=0
# Selectively expose HappyHorse while Wan3.0 remains hidden.
PUBLIC_HAPPYHORSE_MODEL_EXPOSURE_ENABLED=0
# Selectively expose Qwen Image 3.0 while Wan3.0 remains hidden.
PUBLIC_QWEN_IMAGE3_EXPOSURE_ENABLED=0
MAINLAND_BYPASS_TOKEN=
MAINLAND_BYPASS_QUERY_PARAM=cnpass
MAINLAND_BYPASS_COOKIE=cnpass
MAINLAND_BYPASS_MAX_AGE_SECONDS=86400

# Alibaba Cloud Model Studio / Bailian Singapore credentials. Qwen falls back to these when its dedicated variables are empty.
ALIYUN_DASHSCOPE_API_KEY=
ALIYUN_DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com
ALIYUN_QWEN_IMAGE3_BASE_URL=
ALIYUN_QWEN_IMAGE3_API_KEY=
# Wan3.0 can use the public international endpoint or a Singapore Workspace host.
ALIYUN_WAN30_BASE_URL=https://dashscope-intl.aliyuncs.com
ALIYUN_WAN30_API_KEY=
ALIYUN_WAN30_MODEL=wan3.0-video
ALIYUN_WAN30_PRIME_MODEL=wan3.0-video-prime
ALIYUN_WAN30_PRIME_PRICE_FACTOR=1.5
ALIYUN_WAN27_MODEL=wan2.7-i2v-2026-04-25
ALIYUN_WAN27_T2V_MODEL=wan2.7-t2v-2026-06-12
ALIYUN_WAN27_I2V_MODEL=wan2.7-i2v-2026-04-25
ALIYUN_WAN27_R2V_MODEL=wan2.7-r2v-2026-06-12
ALIYUN_WAN27_VIDEO_EDIT_MODEL=wan2.7-videoedit
ALIYUN_WAN_ANIMATE_MOVE_MODEL=wan2.2-animate-move
ALIYUN_WAN_ANIMATE_MIX_MODEL=wan2.2-animate-mix
ALIYUN_HAPPYHORSE_T2V_MODEL=happyhorse-1.1-t2v
ALIYUN_HAPPYHORSE_I2V_MODEL=happyhorse-1.1-i2v
ALIYUN_HAPPYHORSE_R2V_MODEL=happyhorse-1.1-r2v
ALIYUN_HAPPYHORSE_VIDEO_EDIT_MODEL=happyhorse-1.0-video-edit
ALIYUN_WAN27_720P_PURCHASE_CNY_PER_SECOND=0.6
ALIYUN_WAN27_1080P_PURCHASE_CNY_PER_SECOND=1
ALIYUN_WAN27_IMAGE_PRO_PURCHASE_CNY=0.562065
UPSTREAM_USD_CNY_RATE=7.2
ADVANCED_SEEDANCE_720P_USD_PER_MILLION_TOKENS=7
ADVANCED_SEEDANCE_1080P_USD_PER_MILLION_TOKENS=7.7
ADVANCED_SEEDANCE_VIDEO_INPUT_720P_USD_PER_MILLION_TOKENS=4.3
ADVANCED_SEEDANCE_VIDEO_INPUT_1080P_USD_PER_MILLION_TOKENS=4.7
ADVANCED_SEEDANCE_FAST_USD_PER_MILLION_TOKENS=5.6
ADVANCED_SEEDANCE_FAST_VIDEO_INPUT_USD_PER_MILLION_TOKENS=3.3
ADVANCED_SEEDANCE_480P_EXAMPLE_USD_PER_5S=0.35
ADVANCED_SEEDANCE_720P_EXAMPLE_USD_PER_5S=0.76
ADVANCED_SEEDANCE_1080P_EXAMPLE_USD_PER_5S=1.87
ADVANCED_SEEDANCE_VIDEO_INPUT_480P_MIN_EXAMPLE_USD_PER_5S=0.39
ADVANCED_SEEDANCE_VIDEO_INPUT_480P_MAX_EXAMPLE_USD_PER_5S=0.86
ADVANCED_SEEDANCE_VIDEO_INPUT_720P_MIN_EXAMPLE_USD_PER_5S=0.84
ADVANCED_SEEDANCE_VIDEO_INPUT_720P_MAX_EXAMPLE_USD_PER_5S=1.86
ADVANCED_SEEDANCE_VIDEO_INPUT_1080P_MIN_EXAMPLE_USD_PER_5S=2.06
ADVANCED_SEEDANCE_VIDEO_INPUT_1080P_MAX_EXAMPLE_USD_PER_5S=4.57
# Advanced selling prices are managed in the admin pricing table.

# Telegram Undress Mini App. Keep the bot token and webhook secret only in the
# production systemd environment file; never commit real values.
TELEGRAM_BOT_TOKEN=
TELEGRAM_LOGIN_BOT_TOKEN=
TELEGRAM_LOGIN_CLIENT_ID=
TELEGRAM_BOT_WEBAPP_URL=https://undress.14vips.com/
TELEGRAM_BOT_WEBHOOK_SECRET=
TELEGRAM_BOT_WEBHOOK_PATH=/api/telegram/webhook
TELEGRAM_BOT_NOTIFIER_INTERVAL_MS=15000
TELEGRAM_PAYMENT_BOT_TOKEN=
TELEGRAM_PAYMENT_NOTIFY_CHAT_IDS=
TELEGRAM_PAYMENT_NOTIFIER_INTERVAL_MS=15000

# Google Identity Services web client ID. Keep the client secret out of this app;
# the server verifies the returned ID token against Google's tokeninfo endpoint.
GOOGLE_LOGIN_ENABLED=0
GOOGLE_LOGIN_CLIENT_ID=
