+async function insertActivityEventInDb(event = {}) {
+  if (!dbEnabled() || !event.eventId || !event.visitorId) return false;
+  await ensureSchema();
+  const result = await query(`
+    INSERT INTO app_activity_events(event_id, visitor_id, user_id, hostname, tenant_id, tool_id, page_path, event_name, created_at)
+    VALUES ($1, $2, $3, $4, $5, $6, $7, $8, NOW())
+    ON CONFLICT (event_id) DO NOTHING
+  `, [
+    String(event.eventId), String(event.visitorId), String(event.userId || ''),
+    String(event.hostname || 'unknown'), String(event.tenantId || 'main'), String(event.toolId || ''),
+    String(event.pagePath || '/'), String(event.eventName || 'page_view'),
+  ]);
+  return Number(result.rowCount || 0) > 0;
+}
+
+async function getActivitySummaryFromDb({ day = true, days = 1 } = {}) {
+  if (!dbEnabled()) return { days: 1, activeUsers: 0, pageViews: 0, bySite: [] };
+  await ensureSchema();
+  const periodDays = day ? 1 : Math.max(1, Math.min(90, Math.trunc(Number(days || 1)) || 1));
+  const where = `created_at >= NOW() - ($1::int * INTERVAL '1 day')`;
+  const [overall, sites] = await Promise.all([
+    query(`SELECT COUNT(DISTINCT visitor_id)::int AS active_users, COUNT(*)::int AS page_views FROM app_activity_events WHERE ${where}`, [periodDays]),
+    query(`
+      SELECT hostname, tenant_id, tool_id, COUNT(DISTINCT visitor_id)::int AS active_users, COUNT(*)::int AS page_views, MAX(created_at) AS last_seen
+      FROM app_activity_events WHERE ${where}
+      GROUP BY hostname, tenant_id, tool_id
+      ORDER BY active_users DESC, page_views DESC, hostname, tenant_id, tool_id
+      LIMIT 100
+    `, [periodDays]),
+  ]);
+  return {
+    days: periodDays,
+    activeUsers: Number(overall.rows[0]?.active_users || 0),
+    pageViews: Number(overall.rows[0]?.page_views || 0),
+    bySite: sites.rows.map(activityRow),
+  };
+}
